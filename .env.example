# Toteat API Configuration
TOTEAT_API_KEY=your_toteat_api_token_here
TOTEAT_LOCAL_ID=1

# Marketman API Configuration
MARKETMAN_API_URL=https://api.marketman.com
MARKETMAN_API_KEY=a77315ffe6ef4066919faa56627dfcb3        # clave del POS
MARKETMAN_API_PASSWORD=3ad6b90b655d44b0bc318d66a2a726e4  # password proporcionado por MarketMan
MARKETMAN_LOCATION_ID=your_location_id
# Opcional: nombre que se enviará en el payload (aparece en Excel como Location name)
MARKETMAN_LOCATION_NAME=Domani Providencia

# Server Configuration
PORT=3000
NODE_ENV=development

# Cron Schedule (default: every day at 6 AM)
CRON_SCHEDULE=0 6 * * *

# Logging
LOG_LEVEL=info

# Email Configuration (para envio automatico de reportes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_FROM=Domani Ventas <tu_email@gmail.com>
EMAIL_TO=destinatario@email.com
