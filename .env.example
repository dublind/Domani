# Toteat API Configuration (legacy single-location)
TOTEAT_API_KEY=your_toteat_api_token_here
TOTEAT_LOCAL_ID=1

# Multi-location Toteat Configuration
# Agregar LOC1_*, LOC2_*, etc. para cada restaurante
# LOC1_NAME=Nombre Restaurante 1
# LOC1_TOTEAT_TOKEN=TOKEN_LOC1
# LOC1_TOTEAT_RESTAURANT_ID=ID_RESTAURANT_LOC1
# LOC1_TOTEAT_LOCAL_ID=1
# LOC1_TOTEAT_USER_ID=1001
# LOC1_MARKETMAN_BUYER_GUID=BUYER_GUID_LOC1

# Barrio Italia
# LOC6_NAME=Barrio Italia
# LOC6_TOTEAT_TOKEN=ZurihaKnKk65xlipc1XIBtd9WhKQ4CzB
# LOC6_TOTEAT_RESTAURANT_ID=4561779169689600
# LOC6_TOTEAT_LOCAL_ID=4
# LOC6_TOTEAT_USER_ID=1002
# LOC6_MARKETMAN_BUYER_GUID=pendiente

# Marketman API Configuration
MARKETMAN_API_KEY=your_marketman_api_key_here
MARKETMAN_API_PASSWORD=your_marketman_api_password_here
MARKETMAN_BUYER_GUID=your_buyer_guid_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Cron Schedule (default: every day at 6 AM)
CRON_SCHEDULE=0 6 * * *

# Logging
LOG_LEVEL=info

# Email Configuration (para envio automatico de reportes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_FROM=Domani Ventas <tu_email@gmail.com>
EMAIL_TO=destinatario@email.com
